{
  "name": "software-house-website",
  "version": "1.0.0",
  "description": "Prerendered marketing website for a software house (React + Vite).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview --outDir dist/client"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
