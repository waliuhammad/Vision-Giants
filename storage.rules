rules_version = '2';

// - applications/: CVs uploaded through the submitApplication Cloud Function. Private to admins.
// - content/: images uploaded from the admin dashboard (e.g. portfolio screenshots). Publicly readable.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /applications/{allPaths=**} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /content/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/(png|jpeg|webp|avif|gif)');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
