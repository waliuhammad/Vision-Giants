rules_version = '2';

// Access model
// - Public visitors can read published website content and nothing else.
// - Inquiries and job applications are created by the website's forms. The project is on the free
//   Spark plan (no Cloud Functions), so these rules are the validation: visitors may only create a
//   new record with exactly the expected fields and limits, and can never read or change one.
// - Admins are users whose UID has a document in `admins` (create it in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets the dashboard check whether the signed-in user is an admin. Managed in the console only.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Submissions (created by the website's forms, managed by admins) ----
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isEmail(v) {
      return text(v, 5, 254) && v.matches('^[^@ ]+@[^@ ]+[.][^@ ]{2,}$');
    }
    function isLink(v) {
      return v is string && (v == '' || (v.size() <= 500 && v.matches('^https?://.+')));
    }
    // Fields every new submission gets from the form code (src/config/firebase.ts)
    function isNewSubmission(d) {
      return d.consent == true && d.status == 'new' && d.notes == ''
          && d.createdAt == request.time && d.updatedAt == request.time;
    }

    match /inquiries/{id} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
                    && request.resource.data.status in ['new', 'reviewed', 'contacted', 'closed']
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 5000;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'company', 'projectType', 'budget', 'message', 'consent', 'status', 'notes', 'createdAt', 'updatedAt'])
                    && text(request.resource.data.name, 2, 120)
                    && isEmail(request.resource.data.email)
                    && text(request.resource.data.company, 0, 200)
                    && text(request.resource.data.projectType, 1, 80)
                    && text(request.resource.data.budget, 0, 80)
                    && text(request.resource.data.message, 20, 5000)
                    && isNewSubmission(request.resource.data);
    }

    match /applications/{id} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
                    && request.resource.data.status in ['new', 'reviewed', 'reviewing', 'interview', 'rejected', 'hired']
                    && request.resource.data.notes is string && request.resource.data.notes.size() <= 5000;
      allow create: if request.resource.data.keys().hasOnly(['positionId', 'positionTitle', 'name', 'email', 'phone', 'portfolioUrl', 'linkedinUrl', 'message', 'cvUrl', 'consent', 'status', 'notes', 'createdAt', 'updatedAt'])
                    && text(request.resource.data.positionId, 0, 120)
                    && text(request.resource.data.positionTitle, 1, 200)
                    && text(request.resource.data.name, 2, 120)
                    && isEmail(request.resource.data.email)
                    && text(request.resource.data.phone, 0, 40)
                    && isLink(request.resource.data.portfolioUrl)
                    && isLink(request.resource.data.linkedinUrl)
                    && text(request.resource.data.message, 0, 5000)
                    && isLink(request.resource.data.cvUrl) && request.resource.data.cvUrl != ''
                    && isNewSubmission(request.resource.data);
    }

    // ---- Website content (managed in the admin dashboard) ----
    function isContent() {
      return request.resource.data.published is bool && request.resource.data.order is number;
    }

    match /projects/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isContent();
      allow delete: if isAdmin();
    }

    match /services/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isContent();
      allow delete: if isAdmin();
    }

    match /positions/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && isContent();
      allow delete: if isAdmin();
    }

    // `config/public` tells the website whether to use Firestore content or its built-in defaults.
    match /config/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Page text edited in the dashboard: `pages/<page id>` (Admin → Site pages) and
    // `pages/portfolio` (the company profile, which must keep its bio).
    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin() && (id != 'portfolio' || request.resource.data.bio is string);
    }

    // `mail` (email queue) and `rateLimits` are server-only. Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
