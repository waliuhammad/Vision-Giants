rules_version = '2';

// Contact-form inquiries are write-only from the public website:
// visitors can create a validated document but can never read, update or delete.
// Read submissions in the Firebase console or from a trusted server using the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'company', 'projectType', 'budget', 'message', 'consent', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.company is string && request.resource.data.company.size() <= 200
                    && request.resource.data.projectType is string && request.resource.data.projectType.size() <= 80
                    && request.resource.data.budget is string && request.resource.data.budget.size() <= 80
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 20 && request.resource.data.message.size() <= 5000
                    && request.resource.data.consent == true
                    && request.resource.data.createdAt == request.time;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
