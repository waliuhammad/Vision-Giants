# Copy to .env.local and fill in real values. Only VITE_* variables are exposed to the browser —
# never put private keys, service-account JSON or API secrets here.

# Public production URL (used for canonical URLs, Open Graph and sitemap.xml). No trailing slash.
VITE_SITE_URL=https://www.example.com

# --- Firebase (optional; enables contact-form persistence to Firestore) ---
# These are the public web-app config values from Firebase console > Project settings.
# They identify the project; access is controlled by firestore.rules (see README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (optional; enables optimized delivery of uploaded media) ---
# Cloud name only. API key / secret must NEVER be added to frontend env.
VITE_CLOUDINARY_CLOUD_NAME=
